# Local build output
/build/
/build_verify/
/build-*/
compile_commands.json

# Cargo build output (source and Cargo.lock are tracked)
/rust/target/

# Databases produced by running symhow (index outputs, not source)
*.srctrldb
*.srctrlprj

# Editor / tooling caches
__pycache__/
*.py[cod]
/.cache/
.vscode/
*.swp
*~
*.log

# flox: env/ (manifest.toml, manifest.lock, env.json) is intentionally tracked;
# .flox/.gitignore already excludes run/, cache/, lib/, log/ within .flox/.
